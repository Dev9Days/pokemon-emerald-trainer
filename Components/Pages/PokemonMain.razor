@page "/"
@page "/pokemon-main"
@inject ToastService toastService

<div class="trainer-shell">
  <aside class="party-rail" aria-label="파티 포켓몬">
    <div class="party-list">
      @for (int i = 0; i < 6; i++) {
        int index = i;
        bool occupied = index < viewModel.PartyCount && index < viewModel.PokemonInfo.Length;
        var member = occupied ? viewModel.PokemonInfo[index] : null;
        <button type="button" class="party-slot @(occupied && index == viewModel.SelectedPartyIndex ? "active" : "")"
                disabled="@(!occupied)" aria-pressed="@(occupied && index == viewModel.SelectedPartyIndex)"
                aria-label="@(occupied ? $"{index + 1}: {member!.Nickname}" : $"{index + 1}: Empty")"
                title="@(occupied ? member!.Nickname : "Empty")"
                @onclick="() => viewModel.SelectPartyMember(index)">
          @if (!string.IsNullOrEmpty(member?.Image)) {
            <img src="@member.Image" alt="" width="64" height="64" />
          } else {
            <span class="slot-placeholder">@(occupied ? "No Image" : "Empty")</span>
          }
        </button>
      }
    </div>
  </aside>

  <main class="editor-main">
    <fieldset class="editor-fields" disabled="@(!viewModel.IsAttached)">
      <section class="identity-section" aria-label="포켓몬 기본 정보">
        <div class="identity-grid">
          <label class="field nickname-field">
            <span>Nickname:</span>
            <input type="text" @bind="viewModel.Pokemon.Nickname" @bind:event="oninput" maxlength="@(NicknameLength > 0 ? NicknameLength : 10)" />
          </label>
          <label class="field">
            <span>Lv:</span>
            <input type="number" @bind="viewModel.Pokemon.Level" @bind:event="oninput" min="1" max="100" />
          </label>
          <label class="field">
            <span>Experience:</span>
            <input type="number" @bind="viewModel.Pokemon.Experience" @bind:event="oninput" min="0" max="16777216" />
          </label>
          <label class="field">
            <span>Gender:</span>
            <select @bind="viewModel.Pokemon.Gender">
              @if (viewModel.Pokemon.Gender == Gender.Unknown) {
                <option value="@Gender.Unknown">Unknown</option>
              } else {
                @foreach (var s in viewModel.GenderOptions) {
                  @if (s.Key != Gender.Unknown) {
                    <option value="@s.Key">@s.Value</option>
                  }
                }
              }
            </select>
          </label>
          <label class="field">
            <span>Nature:</span>
            <select @bind="viewModel.Pokemon.Nature">
              @foreach (var n in viewModel.NatureOptions) {
                <option value="@n.Key">@n.Value</option>
              }
            </select>
          </label>
          <div class="type-shiny-field">
            <div class="field type-field">
              <span>Type:</span>
              <div class="type-list">
                @if (!string.IsNullOrEmpty(viewModel.Pokemon.Type1Text)) {
                  <span class="type-badge type-@viewModel.Pokemon.Type1.ToLower()">@viewModel.Pokemon.Type1Text</span>
                }
                @if (viewModel.Pokemon.Type2 != string.Empty) {
                  <span class="type-badge type-@viewModel.Pokemon.Type2.ToLower()">@viewModel.Pokemon.Type2Text</span>
                }
              </div>
            </div>
            <label class="shiny-toggle" title="Shiny">
              <span>Shiny:</span>
              <input type="checkbox" aria-label="Shiny" @bind="viewModel.Pokemon.IsShiny" />
              <span class="shiny-icon" aria-hidden="true">✨︎</span>
            </label>
          </div>
        </div>

        @{
          var pidAssessment = viewModel.GetPendingPIDAssessment();
          string pidDetail = pidAssessment == null
            ? "PID 변경 없음. PKHeX 전체 적법성은 미검증입니다."
            : $"{pidAssessment.Origin}. PKHeX 전체 적법성은 미검증입니다.";
        }
        <div class="identity-meta">
          <span>OT: @viewModel.Pokemon.OT (@viewModel.Pokemon.TID/@viewModel.Pokemon.SID)</span>
          <span>Language: @viewModel.Pokemon.Language</span>
          <span>PID: @viewModel.Pokemon.PID</span>
          <div class="legality-status @(pidAssessment == null || pidAssessment.Status == PidMatchStatus.Match ? "ok" : "warn")" role="status" title="@pidDetail">
            <span>PID/IV:</span>
            @if (pidAssessment == null) {
              <span>변경 없음</span>
            } else if (pidAssessment.Status == PidMatchStatus.Match) {
              <span>@pidAssessment.Method 후보 있음</span>
            } else if (pidAssessment.Status == PidMatchStatus.Unsupported) {
              <span>획득 규칙 미확인</span>
            } else {
              <span>조건에 맞는 후보 없음</span>
            }
          </div>
        </div>
      </section>

      <div class="editor-columns">
        <section class="stats-section" aria-label="능력치">
          <table class="stats-table">
            <thead><tr><th>Stat</th><th>Base</th><th>IV</th><th>EV</th><th>Real</th></tr></thead>
            <tbody>
              @for (int i = 0; i < viewModel.Pokemon.Stats.Count; i++) {
                int index = i;
                <tr>
                  <th scope="row">@CompactStatName(viewModel.Pokemon.Stats[index].Name)</th>
                  <td>@viewModel.Pokemon.Stats[index].Base</td>
                  <td><input type="number" aria-label="@(viewModel.Pokemon.Stats[index].Name + " IV")" @bind="viewModel.Pokemon.Stats[index].IV" @bind:event="oninput" min="0" max="31" /></td>
                  <td><input type="number" aria-label="@(viewModel.Pokemon.Stats[index].Name + " EV")" @bind="viewModel.Pokemon.Stats[index].EV" @bind:event="oninput" min="0" max="255" /></td>
                  <td><input type="number" aria-label="@(viewModel.Pokemon.Stats[index].Name + " Real")" @bind="viewModel.Pokemon.Stats[index].RealStat" @bind:event="oninput" min="1" max="999" /></td>
                </tr>
              }
              <tr class="sum-row">
                <th scope="row">Sum</th><td>@viewModel.Pokemon.SumBase</td>
                <td>@(viewModel.Pokemon.SumIV)/186</td><td>@(viewModel.Pokemon.SumEV)/510</td><td>@viewModel.Pokemon.SumStat</td>
              </tr>
            </tbody>
          </table>
          <div class="hidden-power">
            <span>HiddenPower:</span>
            <span class="type-badge type-@viewModel.Pokemon.HiddenPowerTypeEN.ToLower()">@viewModel.Pokemon.HiddenPowerTypeText</span>
            <span class="numeric">Power @viewModel.Pokemon.HiddenPowerValue</span>
          </div>
        </section>

        <div class="moves-condition-column">
          <section class="moves-section" aria-label="기술">
            <div class="move-grid move-headings" aria-hidden="true"><span></span><span>Move</span><span>PP</span><span>PP Up</span></div>
            @for (int i = 0; i < 4; i++) {
              int index = i;
              <div class="move-grid">
                <span class="move-number">@(index + 1)</span>
                <select aria-label="Move @(index + 1)" @bind="viewModel.Pokemon.Moves[index].Number">
                  @foreach (var m in viewModel.MoveOptions) { <option value="@m.Key">@m.Value</option> }
                </select>
                <input type="number" aria-label="Move @(index + 1) PP" @bind="viewModel.Pokemon.Moves[index].PP" @bind:event="oninput" min="0" max="64" />
                <select aria-label="Move @(index + 1) PP Up" @bind="viewModel.Pokemon.Moves[index].PPBonus">
                  <option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option>
                </select>
              </div>
            }
          </section>

          <section class="condition-section" aria-label="컨디션">
            <div class="condition-grid">
              <label class="field"><span>Status:</span>
                <select @bind="viewModel.Pokemon.Status">
                  @foreach (var s in viewModel.StatusOptions) { <option value="@s.Key">@s.Value</option> }
                </select>
              </label>
              <label class="field item-field"><span>Held Item:</span>
                <select @bind="viewModel.Pokemon.HeldItem">
                  @foreach (var item in viewModel.ItemOptions) { <option value="@item.Key">@item.Value</option> }
                </select>
              </label>
              <label class="field friendship-field"><span>Friendship:</span>
                <input type="number" @bind="viewModel.Pokemon.Friendship" @bind:event="oninput" min="0" max="255" />
              </label>
            </div>
            <div class="condition-toggles">
              <label class="checkbox-label"><input type="checkbox" @bind="viewModel.Pokemon.IsObedience" /><span>Obedience(복종)</span></label>
              <label class="checkbox-label"><input type="checkbox" @bind="viewModel.Pokemon.IsPokerus" /><span>Pokérus(포케러스)</span></label>
              @if (viewModel.Pokemon.IsPokerus) {
                <label class="pokerus-days"><span>잔여 일수</span>
                  <select @bind="viewModel.Pokemon.PokerusDaysLeft">
                    <option value="4">4</option><option value="3">3</option><option value="2">2</option><option value="1">1</option><option value="0">0 (Cured)</option>
                  </select>
                </label>
              }
            </div>
          </section>
        </div>
      </div>

      <div class="extras-row">
        <div class="markings-group" aria-label="마킹">
          <span>Markings:</span>
          <label class="marking-toggle" title="원"><input type="checkbox" aria-label="원 마킹" @bind="viewModel.Pokemon.Marking1" /><span aria-hidden="true">●</span></label>
          <label class="marking-toggle" title="네모"><input type="checkbox" aria-label="네모 마킹" @bind="viewModel.Pokemon.Marking2" /><span aria-hidden="true">■</span></label>
          <label class="marking-toggle" title="세모"><input type="checkbox" aria-label="세모 마킹" @bind="viewModel.Pokemon.Marking3" /><span aria-hidden="true">▲</span></label>
          <label class="marking-toggle" title="하트"><input type="checkbox" aria-label="하트 마킹" @bind="viewModel.Pokemon.Marking4" /><span aria-hidden="true">♥</span></label>
        </div>
        <section class="ribbons-section" aria-label="리본">
          <span class="section-label">Ribbons:</span>
          <div class="ribbons-group">
            @foreach (var r in viewModel.RibbonOptions) {
              @if (r.Key != Ribbon.None) {
                <label class="ribbon-checkbox">
                  <input type="checkbox" checked="@viewModel.Pokemon.SelectedRibbons.Contains(r.Key)"
                         @onchange="@((e) => OnRibbonCheckChange(r.Key, e.Value is true))" />
                  <span>@r.Value</span>
                </label>
              }
            }
          </div>
        </section>
      </div>
    </fieldset>

    <div class="encounter-info">
      @if (viewModel.PartyCount > 0) {
        <span>
          @(viewModel.Pokemon.Nickname)은(는) @(viewModel.Pokemon.EncounterLocation)에서
          @if (viewModel.Pokemon.EncounterLevel == 0) {
            <text>Lv.5일 때 부화했습니다.</text>
          } else {
            <text>Lv.@(viewModel.Pokemon.EncounterLevel)일 때 @(viewModel.Pokemon.EncounterBall)로 만났습니다.</text>
          }
        </span>
      }
    </div>
    <footer class="button-group">
      <button type="button" class="btn btn-secondary" disabled="@(!viewModel.IsAttached)" title="다시 불러오기" @onclick="ReloadPokemon"><span class="command-icon icon-refresh" aria-hidden="true"></span>다시 불러오기</button>
      <button type="button" class="btn btn-secondary" disabled="@(!viewModel.IsAttached)" title="임시 저장" @onclick="TempSave"><span class="command-icon icon-save" aria-hidden="true"></span>임시 저장</button>
      <button type="button" class="btn btn-primary" disabled="@(!viewModel.IsAttached)" title="변경 적용" @onclick="ApplyChanges"><span class="command-icon icon-check" aria-hidden="true"></span>변경 적용</button>
      <button type="button" class="btn btn-accent" title="프로세스 잡기" @onclick="AttachProcess"><span class="command-icon icon-plug" aria-hidden="true"></span>프로세스 잡기</button>
    </footer>
  </main>

  <ProcessSelector IsVisible="@viewModel.ShowProcessModal" IsVisibleChanged="@((value) => viewModel.ShowProcessModal = value)" OnProcessSelected="@HandleProcessSelected" />
  <LoadingOverlay IsVisible="@showLoading" Message="에뮬레이터에 연결 중..." />
  <ToastContainer />
</div>

@code {
  private bool showLoading = false;
  private ViewModel.PokemonMainViewModel viewModel = new ViewModel.PokemonMainViewModel();
  private int NicknameLength = 0;

  private static string CompactStatName(string name) => name switch {
    "SpecialAttack" => "Sp. Atk",
    "SpecialDefense" => "Sp. Def",
    _ => name,
  };

  public PokemonMain() {
    // Logger.Debug(Hex.BytesToString(CharDecoder.Decode("POUND")));
    Logger.Debug(CharDecoder.Encode(Hex.HexStringToBytes("37 95 39 AB 39 0F FF")));
  }

  private void OnRibbonCheckChange(Ribbon ribbon, bool isChecked) {
    if (isChecked) {
      if (!viewModel.Pokemon.SelectedRibbons.Contains(ribbon)) {
        viewModel.Pokemon.SelectedRibbons.Add(ribbon);
      }
    } else {
      viewModel.Pokemon.SelectedRibbons.Remove(ribbon);
    }
  }

  private async Task ReloadPokemon() {
    toastService.ShowLoading("데이터를 다시 불러오는 중...");
    try {
      await viewModel.ReloadPokemonAsync(refreshConnection: true);
      toastService.ShowSuccess("포켓몬 데이터를 다시 불러왔습니다");
    } catch (Exception ex) {
      Logger.Error(ex, "포켓몬 데이터 다시 불러오기 실패");
      toastService.ShowError($"데이터를 가져오지 못했습니다: {ex.Message}");
    } finally {
      StateHasChanged();
    }
  }

  private void ApplyChanges() {
    string[] msgs = viewModel.ApplyChanges(allowUncorrelatedPid: true);
    toastService.DismissAll();
    if (msgs.Length > 0) {
      foreach (string msg in msgs) {
        toastService.ShowError(msg, 0);
      }
    } else {
      toastService.ShowSuccess("변경사항이 적용되었습니다");
    }
  }

  private void TempSave() {
    viewModel.TempSave();
    toastService.ShowSuccess("임시 저장되었습니다", 2000);
  }

  private void AttachProcess() {
    viewModel.AttachProcess();
  }

  private async Task HandleProcessSelected(Process process) {
    showLoading = true;
    StateHasChanged();

    try {
      await viewModel.HandleProcessSelectedAsync(process);
      NicknameLength = viewModel.IsEnglish ? 10 : 5;
      toastService.ShowSuccess($"{process.ProcessName} 프로세스에 연결했습니다", 2000);
    } catch (Exception ex) {
      toastService.ShowError($"데이터를 가져오지 못했습니다: {ex.Message}");
    } finally {
      showLoading = false;
      StateHasChanged();
    }
  }
}
