<div class="loading-overlay @(IsVisible ? "visible" : "")" role="status" aria-live="polite" aria-label="@Message">
  <div class="loading-content">
    <div class="loading-spinner" aria-hidden="true"></div>
    <p class="loading-message">@Message</p>
  </div>
</div>

@code {
  [Parameter]
  public bool IsVisible { get; set; }

  [Parameter]
  public string Message { get; set; } = "데이터를 불러오는 중...";
}
